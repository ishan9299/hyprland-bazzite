[Unit]
Description=Hyprland — dynamic tiling Wayland compositor session
Documentation=man:hyprland(1)
BindsTo=graphical-session.target
Before=graphical-session.target plasma-polkit-agent.service xdg-desktop-portal.service xdg-desktop-portal-hyprland.service
Wants=plasma-polkit-agent.service xdg-desktop-portal.service xdg-desktop-portal-hyprland.service
After=graphical-session-pre.target
CollectMode=inactive-or-failed

[Service]
Type=notify
NotifyAccess=all
ExecStart=/usr/bin/start-hyprland
Restart=no
TimeoutStartSec=60
TimeoutStopSec=30
SyslogIdentifier=hyprland
Slice=session.slice
